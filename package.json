{
  "name": "dsh-token-dashboard",
  "version": "0.1.0",
  "description": "Token-usage dashboard for DeepSeek Harness — a Codex-style usage panel inside Settings. · DSH 用量统计面板：在设置里查看 token 消耗、缓存命中、上下文占用与历史趋势。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "token",
    "usage",
    "dashboard",
    "statistics",
    "cordis",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etheslay/dsh-token-dashboard.git"
  },
  "homepage": "https://github.com/Etheslay/dsh-token-dashboard#readme",
  "bugs": {
    "url": "https://github.com/Etheslay/dsh-token-dashboard/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "comment:peerDependencies": "These are provided by the DSH host process / browser module table at runtime. They are marked optional so npm never tries to fetch them, and the package itself has no runtime dependencies of its own.",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/render.test.mjs && node tests/client-bundle.test.mjs && node tests/host-route.test.mjs",
    "test:render": "node tests/render.test.mjs",
    "test:client": "node tests/client-bundle.test.mjs",
    "test:host": "node tests/host-route.test.mjs",
    "preview": "node scripts/preview.mjs",
    "prepack": "node scripts/build.mjs"
  }
}
